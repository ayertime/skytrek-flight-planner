# SkyTrek - API key template
#
# 1. Copy this file to `.streamlit/secrets.toml` (same folder)
# 2. Paste your own keys below
# 3. Never commit secrets.toml - it is gitignored on purpose
#
# Both keys are OPTIONAL. Without them the app still runs; live flight
# search and live gate lookups fall back to simulated data.

# https://serpapi.com/google-flights-api
SERPAPI_API_KEY = ""

# https://flightaware.com/commercial/aeroapi/
FLIGHTAWARE_API_KEY = ""
